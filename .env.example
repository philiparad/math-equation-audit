# Development: no authentication only on your own computer.
APP_ENV=development
# For any public deployment, set production and a LONG random token.
APP_ACCESS_TOKEN=
MATHPIX_APP_ID=
MATHPIX_APP_KEY=
# Render persistent disk example: /var/data/math-equation-audit
DATA_DIR=./data
# Optional only when frontend is hosted on GitHub Pages separately.
CORS_ORIGINS=
